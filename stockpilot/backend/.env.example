# Copy to .env (or set in your host's dashboard). Never commit real values.
ANTHROPIC_API_KEY=
JWT_SECRET=replace-with-a-long-random-string
DATABASE_URL=sqlite:///./stockpilot.db
# Shared secret you also paste into RevenueCat > Integrations > Webhooks > Authorization header
REVENUECAT_WEBHOOK_SECRET=
CLAUDE_MODEL=claude-opus-5-5
# Weekly Plan, Trend Scout and Product Check use the most capable model (costs more per run)
CLAUDE_RESEARCH_MODEL=claude-fable-5-1
FREE_AI_CALLS_PER_MONTH=3
FREE_FORECAST_PRODUCTS=10
CORS_ORIGINS=*
