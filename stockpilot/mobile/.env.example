# Copy to .env.local. EXPO_PUBLIC_ values are bundled into the app, so only put public values here.
# Your deployed backend, e.g. https://api.yourdomain.com  (Android emulator -> local machine: http://10.0.2.2:8000)
# Leave empty to build the app without a server: it then runs fully on the phone (no accounts, no AI features).
EXPO_PUBLIC_API_URL=
# Where the app downloads the latest trends list (a plain JSON file; free to host on GitHub)
EXPO_PUBLIC_TRENDS_URL=
# RevenueCat > Project settings > API keys > Google Play public SDK key (starts with goog_)
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
